# Flask Security & Environment Mode
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=mazi-ai-production-secret-key-change-in-prod-2026

# Database & Machine Learning Asset Paths
DB_PATH=mazi.db
MODEL_PATH=models/fraud_model.pkl

# Default AI Risk Engine Threshold (0 - 100)
FRAUD_THRESHOLD=75